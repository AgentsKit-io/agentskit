{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.json",
    "tsconfig.base.json",
    "scripts/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "outputs": [],
      "env": [
        "CI_TEST_PROFILE"
      ]
    },
    "test:coverage": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "env": [
        "CI_TEST_PROFILE"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
