{
  "name": "@agentskit/cli",
  "version": "0.13.48",
  "description": "CLI for AgentsKit chat and project scaffolding.",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "agentskit",
    "ai",
    "agents",
    "llm",
    "chat",
    "typescript",
    "cli",
    "command-line",
    "scaffolding",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "chatgpt",
    "ai-agents",
    "autonomous-agents",
    "create-app",
    "terminal"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentskit": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@agentskit/adapters": "workspace:*",
    "@agentskit/core": "workspace:*",
    "@agentskit/cross-platform": "workspace:*",
    "@agentskit/ink": "workspace:*",
    "@agentskit/integrations": "workspace:*",
    "@agentskit/memory": "workspace:*",
    "@agentskit/net": "workspace:*",
    "@agentskit/rag": "workspace:*",
    "@agentskit/runtime": "workspace:*",
    "@agentskit/skills": "workspace:*",
    "@agentskit/tools": "workspace:*",
    "@inquirer/prompts": "^8.7.4",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "ink": "^7.1.1",
    "kleur": "^4.1.5",
    "localtunnel": "^2.0.2",
    "react": "^19.3.1",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "happy-dom": "^20.14.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "agentskit": {
    "stability": "beta",
    "stabilityNote": "chat, init, run commands stable."
  },
  "license": "MIT",
  "homepage": "https://www.agentskit.io/docs/reference/packages/cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentsKit-io/agentskit",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/AgentsKit-io/agentskit/issues"
  },
  "author": "AgentsKit Contributors"
}
