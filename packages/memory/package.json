{
  "name": "@agentskit/memory",
  "version": "0.11.14",
  "description": "Persistent and vector memory backends for AgentsKit.",
  "keywords": [
    "agentskit",
    "ai",
    "agents",
    "llm",
    "chat",
    "typescript",
    "memory",
    "vector",
    "embeddings",
    "openai",
    "anthropic",
    "ai-agents",
    "vector-db",
    "sqlite",
    "redis",
    "rag",
    "vector-search",
    "persistence"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./personalization": {
      "types": "./dist/personalization.d.ts",
      "import": "./dist/personalization.js",
      "require": "./dist/personalization.cjs"
    },
    "./web-storage": {
      "types": "./dist/web-storage.d.ts",
      "import": "./dist/web-storage.js",
      "require": "./dist/web-storage.cjs"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js",
      "require": "./dist/postgres.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "pnpm exec turbo run build --filter=@agentskit/memory --concurrency=2 && vitest run",
    "test:coverage": "pnpm exec turbo run build --filter=@agentskit/memory --concurrency=2 && vitest run --coverage",
    "lint": "tsc --noEmit",
    "dev": "tsup --watch",
    "test:postgres": "pnpm exec turbo run build --filter=@agentskit/memory --concurrency=2 && vitest run tests/postgres.integration.test.ts",
    "test:workerd": "pnpm exec turbo run build --filter=@agentskit/memory --concurrency=2 && node tests/postgres-workerd.mjs"
  },
  "dependencies": {
    "@agentskit/core": "workspace:*",
    "@agentskit/net": "workspace:*"
  },
  "peerDependencies": {
    "vectra": "^0.15.0",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1"
  },
  "peerDependenciesMeta": {
    "vectra": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agentskit/cross-platform": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.5",
    "better-sqlite3": "^13.0.3",
    "redis": "^6.2.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vectra": "^0.15.0",
    "vitest": "^4.1.11",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "@types/pg": "^8.15.6",
    "wrangler": "^4.148.0"
  },
  "agentskit": {
    "stability": "beta",
    "stabilityNote": "File/SQLite/Redis backends \u2014 Memory contract v1."
  },
  "license": "MIT",
  "homepage": "https://www.agentskit.io/docs/reference/packages/memory",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentsKit-io/agentskit",
    "directory": "packages/memory"
  },
  "bugs": {
    "url": "https://github.com/AgentsKit-io/agentskit/issues"
  },
  "author": "AgentsKit Contributors",
  "engines": {
    "node": ">=20.19"
  }
}
