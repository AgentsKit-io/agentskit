{
  "name": "@agentskit/ink",
  "version": "0.10.10",
  "description": "Ink terminal components and hooks for AgentsKit.",
  "keywords": [
    "agentskit",
    "ai",
    "agents",
    "llm",
    "chat",
    "typescript",
    "ink",
    "terminal",
    "cli",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "chatgpt",
    "ai-agents",
    "tui",
    "chat-ui",
    "streaming"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "pnpm build && vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "lint": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@agentskit/core": "workspace:*",
    "ink": "^7.1.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0",
    "react": "19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "agentskit": {
    "stability": "beta",
    "stabilityNote": "Terminal UI with the shared ChatReturn controller contract and terminal-specific components."
  },
  "license": "MIT",
  "homepage": "https://www.agentskit.io/docs/reference/packages/ink",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentsKit-io/agentskit",
    "directory": "packages/ink"
  },
  "bugs": {
    "url": "https://github.com/AgentsKit-io/agentskit/issues"
  },
  "author": "AgentsKit Contributors"
}
