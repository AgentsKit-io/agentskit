{
  "name": "@agentskit/observability",
  "version": "0.12.1",
  "description": "Logging and tracing layer for AgentsKit agents.",
  "keywords": [
    "agentskit",
    "ai",
    "agents",
    "llm",
    "chat",
    "typescript",
    "observability",
    "tracing",
    "opentelemetry",
    "openai",
    "anthropic",
    "ai-agents",
    "langsmith",
    "logging",
    "monitoring",
    "telemetry",
    "otlp"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./trace-tracker": {
      "types": "./dist/trace-tracker.d.ts",
      "import": "./dist/trace-tracker.js",
      "require": "./dist/trace-tracker.cjs"
    },
    "./cost-guard": {
      "types": "./dist/cost-guard.d.ts",
      "import": "./dist/cost-guard.js",
      "require": "./dist/cost-guard.cjs"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js",
      "require": "./dist/postgres.cjs"
    },
    "./cost-store-contract": {
      "types": "./dist/cost-store-contract.d.ts",
      "import": "./dist/cost-store-contract.js",
      "require": "./dist/cost-store-contract.cjs"
    },
    "./langfuse": {
      "types": "./dist/langfuse.d.ts",
      "import": "./dist/langfuse.js",
      "require": "./dist/langfuse.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "dev": "tsup --watch",
    "test:postgres": "pnpm exec turbo run build --filter=@agentskit/observability --concurrency=2 && vitest run tests/postgres.integration.test.ts",
    "test:cjs": "pnpm exec turbo run build --filter=@agentskit/observability --concurrency=2 && node tests/cjs-smoke.cjs",
    "test:workerd": "pnpm exec turbo run build --filter=@agentskit/observability --concurrency=2 && node tests/postgres-workerd.mjs"
  },
  "dependencies": {
    "@agentskit/core": "workspace:*",
    "@agentskit/net": "workspace:*"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0 || ^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "drizzle-orm": "^0.44.0 || ^0.45.3",
    "langfuse": "^3.38.20",
    "langsmith": "^0.8.1",
    "pg": "^8.23.1"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "langfuse": {
      "optional": true
    },
    "langsmith": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0 || ^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@agentskit/cross-platform": "workspace:*",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.15.6",
    "drizzle-orm": "^0.45.3",
    "langfuse": "^3.38.20",
    "langsmith": "^0.8.1",
    "pg": "^8.23.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  },
  "agentskit": {
    "stability": "beta",
    "stabilityNote": "Observer contract stable; integration coverage growing."
  },
  "license": "MIT",
  "homepage": "https://www.agentskit.io/docs/reference/packages/observability",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentsKit-io/agentskit",
    "directory": "packages/observability"
  },
  "bugs": {
    "url": "https://github.com/AgentsKit-io/agentskit/issues"
  },
  "author": "AgentsKit Contributors",
  "engines": {
    "node": ">=20.19"
  }
}
